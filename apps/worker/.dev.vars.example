# Copy to .dev.vars (gitignored) for local dev.
# Real values set in CF dashboard for staging/production.

JWT_SIGNING_KEY=DEV_ONLY_REPLACE_WITH_32_BYTE_BASE64URL_VALUE
# Separate, rotation-stable source identity key for the TeleStaff ingestion
# route. Never reuse JWT_SIGNING_KEY, and never commit a real value.
TELESTAFF_HMAC_KEY=DEV_ONLY_REPLACE_WITH_32_BYTE_RANDOM_VALUE
PORTAL_BID_FEDERATION_TOKEN=DEV_ONLY_NOT_A_REAL_FEDERATION_TOKEN

# The member PIN is initialized explicitly in the KV binding at
# `settings:member_bid_pin`; there is no default or PIN environment variable.
