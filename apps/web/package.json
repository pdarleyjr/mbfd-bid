{
  "name": "@mbfd/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -r --filter @mbfd/shared --filter @mbfd/eligibility --filter @mbfd/a-day run build",
    "prebuild": "pnpm -r --filter @mbfd/shared --filter @mbfd/eligibility --filter @mbfd/a-day run build",
    "dev": "next dev --turbo --port 3000",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env staging --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:opennext:staging": "node --env-file=.env.staging ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build --env staging",
    "preview:opennext:staging": "pnpm build:opennext:staging && node --env-file=.env.staging ./node_modules/@opennextjs/cloudflare/dist/cli/index.js preview --env staging",
    "deploy:staging": "pnpm build:opennext:staging && node --env-file=.env.staging ./node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy --env staging",
    "build:opennext:production": "node --env-file=.env.production ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build --env production",
    "preview:opennext:production": "pnpm build:opennext:production && node --env-file=.env.production ./node_modules/@opennextjs/cloudflare/dist/cli/index.js preview --env production",
    "deploy:production": "pnpm build:opennext:production && node --env-file=.env.production ./node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy --env production"
  },
  "dependencies": {
    "@mbfd/shared": "workspace:*",
    "@noble/hashes": "^1.4",
    "@radix-ui/react-slot": "1.1.0",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "12.38.0",
    "hono": "4.12.34",
    "jose": "5.9.4",
    "lucide-react": "0.453.0",
    "nanoid": "5.1.16",
    "next": "15.5.24",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "@fontsource-variable/plus-jakarta-sans": "5.1.0",
    "@fontsource-variable/source-sans-3": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@mbfd/worker": "workspace:*",
    "@opennextjs/cloudflare": "1.20.4",
    "@playwright/test": "1.60.0",
    "@types/node": "22.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vitest": "3.2.6",
    "wrangler": "^4.125.0"
  }
}
