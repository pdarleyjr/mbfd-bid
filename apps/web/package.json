{
  "name": "@mbfd/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @mbfd/shared build",
    "prebuild": "pnpm --filter @mbfd/shared build",
    "dev": "next dev --turbo --port 3000",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:pages": "next-on-pages",
    "deploy:staging": "pnpm build:pages && wrangler pages deploy .vercel/output/static --project-name=mbfd-bid-web-staging --branch=main --commit-dirty=true",
    "deploy:production": "pnpm build:pages && wrangler pages deploy .vercel/output/static --project-name=mbfd-bid-web-production --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@mbfd/shared": "workspace:*",
    "@noble/hashes": "^1.4",
    "@radix-ui/react-slot": "1.1.0",
    "@tanstack/react-query": "5.59.16",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "12.38.0",
    "hono": "4.6.5",
    "jose": "5.9.4",
    "lucide-react": "0.453.0",
    "nanoid": "^5.0",
    "next": "15.5.18",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.12",
    "@cloudflare/workers-types": "4.20241011.0",
    "@fontsource-variable/plus-jakarta-sans": "5.1.0",
    "@fontsource-variable/source-sans-3": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@mbfd/worker": "workspace:*",
    "@playwright/test": "1.60.0",
    "@types/node": "22.7.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vercel": "^39.3.0",
    "vitest": "2.1.4",
    "wrangler": "^4"
  }
}
