# Web app environment variables (copy to .env.local for dev).
NEXT_PUBLIC_WORKER_BASE=http://localhost:8787

# These are read server-side in middleware + Server Components:
JWT_SIGNING_KEY=DEV_ONLY_REPLACE_WITH_64_HEX_CHARS
# Generate with: node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('2300')).then(b=>console.log('sha256:'+Buffer.from(b).toString('hex')))"
PIN_HASH=sha256:REPLACE_WITH_PIN_SHA256_HEX
