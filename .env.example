# Copy to .env (gitignored) for local development.
# Real values live in Cloudflare (wrangler secret) and GitHub Actions secrets.
# Never commit a populated copy.

# ─── Worker (apps/worker/.dev.vars) ───
JWT_SIGNING_KEY=DEV_ONLY_REPLACE_WITH_64_HEX_CHARS_______________________________
PIN_HASH=$2b$12$ReplaceWithBcryptHashOfYourLocalDevPin
PORTAL_BID_READER=DEV_PORTAL_VERIFY_CREDENTIALS_TOKEN
PORTAL_BID_WRITER=DEV_PORTAL_BID_ASSIGNMENT_TOKEN
PORTAL_BASE_URL=https://portal.mbfdhub.com

# ─── Web (apps/web/.env.local) ───
NEXT_PUBLIC_WORKER_BASE=http://localhost:8787
PIN_PLAIN=2300

# ─── E2E ───
E2E_REAL_JWT=1
E2E_JWT_SIGNING_KEY=test_only_dev_key_replace_via_GH_secret_in_CI

# ─── Notes ───
# CLOUDFLARE_API_TOKEN     — set via `wrangler login` OR env var; NOT in this file
# CLOUDFLARE_ACCOUNT_ID    — in GitHub Actions secrets only
# R2_ACCESS_KEY_ID         — Wrangler secret
# R2_SECRET_ACCESS_KEY     — Wrangler secret
# AUDIT_SIGNING_PRIVKEY    — Wrangler secret (ed25519 — Plan 08)
# ANTHROPIC_API_KEY        — DEPRECATED (Workers AI swap, 2026-05). The bid
#                            worker now uses the env.AI binding (Llama 3.3
#                            70B on Cloudflare); no external key required.
