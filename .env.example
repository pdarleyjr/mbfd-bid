# Copy to .env (gitignored) for local development.
# Real values live in protected local or Cloudflare secret stores.
# Never commit a populated copy or use it to enable portal publication.

# ─── Worker (apps/worker/.dev.vars) ───
JWT_SIGNING_KEY=DEV_ONLY_REPLACE_WITH_64_HEX_CHARS_______________________________
PORTAL_BID_FEDERATION_TOKEN=DEV_ONLY_NOT_A_REAL_FEDERATION_TOKEN
# PORTAL_BID_WRITER is intentionally omitted. Writeback remains disabled unless
# a separately authorized production control provides its dedicated writer.
PORTAL_BASE_URL=https://www.mbfdhub.com

# ─── Web (apps/web/.env.local) ───
NEXT_PUBLIC_WORKER_BASE=http://localhost:8787
# The member PIN is an explicitly configured Worker KV setting
# (`settings:member_bid_pin`), not an environment variable and never has a default.

# ─── E2E ───
E2E_REAL_JWT=1
E2E_JWT_SIGNING_KEY=test_only_dev_key_replace_via_protected_CI_secret

# ─── Notes ───
# CLOUDFLARE_API_TOKEN     — set via `wrangler login` OR env var; NOT in this file
# CLOUDFLARE_ACCOUNT_ID    — protected deployment environment only
# R2_ACCESS_KEY_ID         — Wrangler secret
# R2_SECRET_ACCESS_KEY     — Wrangler secret
# AUDIT_SIGNING_PRIVKEY    — Wrangler secret (ed25519 — Plan 08)
# ANTHROPIC_API_KEY        — DEPRECATED (Workers AI swap, 2026-05). The bid
#                            worker now uses the env.AI binding (Llama 3.3
#                            70B on Cloudflare); no external key required.
