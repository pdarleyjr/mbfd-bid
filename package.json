      "drizzle-orm": ">=0.45.2 <1",
      "postcss": "8.5.23",
      "tar": "7.5.11",
      "ws": "8.21.3",
      "cookie": "0.7.2",
      "@tootallnate/once": "3.0.1",
      "undici@<6.24.0": "6.24.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "esbuild": "0.28.1",
      "sharp": "0.35.4",
      "ajv": "8.20.0",
      "vite": "7.3.5",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
