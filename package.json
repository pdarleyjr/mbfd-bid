{
  "name": "mbfd-bid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "deploy:staging": "pnpm -r deploy:staging"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.18 <5",
      "drizzle-orm": ">=0.45.2 <1"
    }
  }
}
